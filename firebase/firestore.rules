rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && (request.auth.token.get('role', '') == 'owner'
        || (request.auth.token.get('admin', false) == true
          && request.auth.token.get('accountManager', false) == true));
    }
    function isAccountManager() {
      return isOwner() || memberRole() == 'super_admin';
    }
    function validEmail(email) {
      return email is string && email.size() <= 254
        && email.matches('[a-z0-9_%+-]+(\\.[a-z0-9_%+-]+)*@[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+');
    }
    function isVerifiedGoogle() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'
        && request.auth.token.get('email', '') is string
        && validEmail(request.auth.token.get('email', '').lower());
    }
    function ownAccountPath() {
      return /databases/$(database)/documents/adminAccounts/$(request.auth.token.email.lower());
    }
    function memberRole() {
      return isVerifiedGoogle() && exists(ownAccountPath())
        && get(ownAccountPath()).data.enabled == true
        && get(ownAccountPath()).data.email == request.auth.token.email.lower()
        && get(ownAccountPath()).data.get('role', 'admin') in ['admin', 'super_admin']
        ? get(ownAccountPath()).data.get('role', 'admin') : '';
    }
    function isAdmin() {
      return isOwner() || memberRole() in ['admin', 'super_admin'];
    }
    match /adminAccounts/{email} {
      function validAccount(data) {
        return data.keys().hasAll(['email', 'displayName', 'enabled', 'createdAt', 'updatedAt', 'createdBy'])
          && data.keys().hasOnly(['email', 'displayName', 'enabled', 'createdAt', 'updatedAt', 'createdBy', 'role'])
          && validEmail(email)
          && data.email == email
          && data.get('role', 'admin') in ['admin', 'super_admin']
          && data.displayName is string && data.displayName.size() <= 120
          && data.enabled is bool
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.createdBy is string;
      }
      function isOtherAccount() {
        return email != request.auth.token.get('email', '').lower();
      }
      function canModifyAccount() {
        return isAccountManager() && isOtherAccount()
          && (resource.data.get('role', 'admin') == 'admin'
            || (isOwner() && resource.data.get('role', 'admin') == 'super_admin'));
      }
      allow get: if isAccountManager()
        || (isVerifiedGoogle() && email == request.auth.token.email.lower());
      allow list: if isAccountManager();
      allow create: if isAccountManager() && validAccount(request.resource.data)
        && isOtherAccount()
        && request.resource.data.keys().hasAll(['role'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canModifyAccount() && validAccount(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time;
      allow delete: if canModifyAccount();
    }
    function validAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'url', 'status', 'publishAt', 'publishedAt', 'createdAt', 'updatedAt', 'createdBy'])
        && data.keys().hasOnly(['title', 'body', 'url', 'status', 'publishAt', 'publishedAt', 'createdAt', 'updatedAt', 'createdBy'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() > 0 && data.body.size() <= 10000
        && data.url is string && data.url.size() <= 2048
        && (data.url == '' || data.url.matches('https://[^\\s]+'))
        && data.status in ['draft', 'scheduled', 'published', 'archived']
        && data.publishAt is timestamp
        && (data.publishedAt == null || data.publishedAt is timestamp)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string;
    }
    match /announcements/{id} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && validAnnouncement(request.resource.data)
        && request.resource.data.status in ['draft', 'scheduled']
        && request.resource.data.publishedAt == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validAnnouncement(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.publishedAt == resource.data.publishedAt
        && ((resource.data.status in ['draft', 'scheduled']
            && request.resource.data.status in ['draft', 'scheduled', 'archived'])
          || (resource.data.status == 'published' && request.resource.data.status == 'archived'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if isAdmin() && resource.data.status in ['draft', 'scheduled'];
    }
    match /devices/{uid} {
      function ownsDevice() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
      }
      function validDevice(data) {
        return data.keys().hasAll(['expoPushToken', 'platform', 'enabled', 'updatedAt'])
          && data.keys().hasOnly(['expoPushToken', 'platform', 'enabled', 'updatedAt'])
          && data.expoPushToken is string && data.expoPushToken.size() <= 256
          && data.expoPushToken.matches('(ExponentPushToken|ExpoPushToken)\\[[A-Za-z0-9_-]+\\]')
          && data.platform in ['ios', 'android'] && data.enabled is bool
          && data.updatedAt == request.time;
      }
      allow get: if ownsDevice();
      allow create, update: if ownsDevice() && validDevice(request.resource.data);
      allow delete: if ownsDevice();
      allow list: if false;
    }
    // Jobs, batches, token deduplication and receipts belong only to the Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
